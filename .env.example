# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Legacy name — set to the same value if using @supabase/auth-helpers-nextjs
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# App URL (used for Yo! Payments IPN callbacks and auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Yo! Payments (sandbox: sandbox.yo.co.ug | production: paymentsapi1.yo.co.ug)
YO_API_USERNAME=your-yo-api-username
YO_API_PASSWORD=your-yo-api-password
# Optional override (defaults to sandbox/production URLs)
# YO_API_URL=https://sandbox.yo.co.ug/services/yopaymentsdev/task.php

# Yo IPN signature verification — paste Yo Uganda public key PEM (production or sandbox)
# YO_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Visa/Mastercard hosted checkout URL from Yo! (when enabled on your business account)
# Template placeholders: {amount} {currency} {external_ref} {return_url}
# YO_CARD_CHECKOUT_URL=https://your-yo-card-checkout.example/pay?amount={amount}&ref={external_ref}&return={return_url}

# Optional: strict rate limiting with Upstash Redis (recommended for production)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
